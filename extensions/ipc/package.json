{
  "name": "pi-ipc",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/richardgill/pi-extensions/tree/main/extensions/ipc",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardgill/pi-extensions",
    "directory": "extensions/ipc"
  },
  "bin": {
    "pi-ipc-send": "./src/cli.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "tsc": "tsc -p tsconfig.json --noEmit",
    "pi-ipc-send": "node --import tsx src/cli.ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@richardgill/pi-config": "workspace:*",
    "tsx": "4.21.0",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
