{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "extensions/background-bash": {
      "entry": ["src/index.ts", "tests/**/*.{unit,integration,e2e}.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "extensions/context-commands": {
      "entry": ["src/index.ts", "tests/**/*.{unit,integration,e2e}.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "extensions/project-resources": {
      "entry": ["tests/**/*.{unit,integration,e2e}.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "extensions/bash-timeout-guard": {
      "entry": ["src/index.ts", "tests/**/*.{unit,integration,e2e}.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "extensions/pi-up-history": {
      "entry": ["src/index.ts", "tests/**/*.{unit,integration,e2e}.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "extensions/tmux-bash": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "extensions/preset": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "extensions/sub-pi": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "extensions/sub-pi-skill": {
      "entry": ["src/index.ts", "tests/**/*.{unit,integration,e2e}.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/pi-config": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["overlay/**"],
  "ignoreExportsUsedInFile": {
    "type": true
  },
  "ignoreDependencies": [
    "@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui",
    "@sinclair/typebox"
  ],
  "ignoreIssues": {
    "extensions/preset/src/extension.ts": ["duplicates"]
  }
}
