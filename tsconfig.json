{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@richardgill/pi-tmux-bash": ["./extensions/tmux-bash/src/extension.ts"],
      "@richardgill/pi-tmux-bash/core": ["./extensions/tmux-bash/src/core.ts"],
      "@richardgill/pi-file-collector": ["./extensions/file-collector/src/extension.ts"],
      "@richardgill/pi-files": ["./extensions/files/src/extension.ts"],
      "@richardgill/pi-extra-context-files": ["./extensions/extra-context-files/src/index.ts"],
      "@richardgill/pi-preset": ["./extensions/preset/src/extension.ts"],
      "@richardgill/pi-sub-pi": ["./extensions/sub-pi/src/extension.ts"],
      "@richardgill/pi-sub-pi-skill": ["./extensions/sub-pi-skill/src/extension.ts"],
      "pi-bash-timeout-guard": ["./extensions/bash-timeout-guard/src/extension.ts"],
      "@richardgill/pi-config": ["./packages/pi-config/src/index.ts"],
      "@richardgill/pi-zod-tool-call": ["./packages/pi-zod-tool-call/src/index.ts"],
      "@richardgill/lib": ["./packages/lib/src/index.ts"]
    }
  },
  "include": [
    "index.ts",
    "extensions/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}
